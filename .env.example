# PostgreSQL
POSTGRES_DB=gymsaas
POSTGRES_PORT=5432
POSTGRES_OWNER_USER=gymsaas_owner
POSTGRES_OWNER_PASSWORD=gymsaas_owner_pw
POSTGRES_APP_USER=gymsaas_app
POSTGRES_APP_PASSWORD=gymsaas_app_pw

# Backend
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
DEMO_DATA_ENABLED=true
# Optional PEM keys (base64 or full PEM). When empty, an ephemeral RSA key is generated at boot.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
COOKIE_SECURE=false

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
